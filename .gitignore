# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/mobile/android/app/debug
/mobile/android/app/profile
/mobile/android/app/release

# Generated caches and scratch directories (e.g. Node's compile cache,
# server test upload fixtures created via fs.mkdtemp(".tmp-"))
.tmp/
.tmp-*/
node-compile-cache/

# Local Cloudflare tunnel binary; keep developer tooling on disk, never in Git.
/cloudflared.exe

# Firebase was removed; do not recommit generated client configuration.
/mobile/android/app/google-services.json
/mobile/ios/Runner/GoogleService-Info.plist
/mobile/lib/firebase_options.dart

# Copy to server/.env for local development and fill in real values.
# Never commit server/.env — it is gitignored. In production (Vercel), set
# these as project Environment Variables instead; Vercel does not read this
# file. See ../README.md ("Deploy the API to Vercel") and
# ../docs/production-security.md for the full explanation of each setting.

# --- Core server ---
PORT=8080
HOST=0.0.0.0
# Local dev default; in production this must be your https:// Vercel domain.
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=./data/uploads
# Comma-separated list of allowed browser/app origins for CORS. Required
# (non-empty) in production.
ALLOWED_ORIGINS=
# Required (true) in production/Vercel so req.ip (rate limiting) and
# req.secure (HSTS) reflect the real client instead of Vercel's proxy. Leave
# false for local dev, which has no reverse proxy in front of it.
TRUST_PROXY=false

# --- Auth / OTP ---
# Random string, 32+ chars in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_PHONE_LIMIT=10
OTP_DAILY_IP_LIMIT=30

# --- Cron (Vercel Cron calls api/cron/cleanup with this bearer secret) ---
# Random string, 32+ chars in production.
CRON_SECRET=

# --- SMS / OTP delivery ---
# console (dev only; returns the OTP in the API response) or twilio.
# Production must use twilio.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- Gemini (text/JSON analysis + virtual try-on image generation) ---
# Legacy shared key; used only when the split keys below are unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEXT_API_KEY=
GEMINI_TEXT_MAX_RETRIES=1
GEMINI_TEXT_FALLBACK_MODEL=
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MAX_RETRIES=0
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_FALLBACK_MODEL=
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
GEMINI_IMAGE_HIGH_QUALITY_MODE=false
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_ASPECT_RATIO=3:4
# Vercel Hobby plan caps functions at 60s; keep this at 55000 there.
# Raise toward 120000 only on Vercel Pro (maxDuration 300s+).
GEMINI_IMAGE_TIMEOUT_MS=55000
GEMINI_IMAGE_MAX_INPUT_PX=1024

# --- PostgreSQL ---
DATABASE_URL=
DATABASE_POOL_MAX=10
# Production requires true. Standard local Postgres installs should keep false.
DATABASE_SSL=false
# DigitalOcean managed Postgres uses a cert Node doesn't trust by default;
# set to false when connecting to it (see README).
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Cloudinary (private/authenticated image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nera
# Required in production so signed media URLs expire. Create under
# Cloudinary console > Settings > Security > Token-based authentication.
CLOUDINARY_AUTH_TOKEN_KEY=
CLOUDINARY_SIGNED_URL_TTL_SECONDS=900
# cloudinary in production; local is development-only.
IMAGE_STORAGE_PROVIDER=cloudinary

# --- Retention / cleanup (server/src/services/maintenance.service.ts) ---
CLEANUP_INTERVAL_MINUTES=360
OTP_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
ANALYSIS_JOB_RETENTION_DAYS=14
MEDIA_ASSET_RETENTION_DAYS=14
TRYON_UNSAVED_RETENTION_HOURS=24

# --- Rate limits (shared fixed window) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=120
RATE_LIMIT_PROFILE_ANALYSIS_MAX=3
RATE_LIMIT_WARDROBE_ANALYSIS_MAX=10
RATE_LIMIT_OUTFIT_GENERATION_MAX=10
RATE_LIMIT_TRYON_MAX=2

# --- AI usage quotas ---
AI_DAILY_PROFILE_ANALYSIS_LIMIT=3
AI_DAILY_WARDROBE_ANALYSIS_LIMIT=30
AI_DAILY_OUTFIT_GENERATION_LIMIT=30
AI_DAILY_TRYON_LIMIT=5
AI_MONTHLY_PROFILE_ANALYSIS_LIMIT=20
AI_MONTHLY_WARDROBE_ANALYSIS_LIMIT=300
AI_MONTHLY_OUTFIT_GENERATION_LIMIT=300
AI_MONTHLY_TRYON_LIMIT=50
AI_CONCURRENT_REQUESTS_PER_USER=1
AI_RESERVATION_TIMEOUT_MINUTES=10
AI_USAGE_RETENTION_DAYS=400

# --- Weather (Open-Meteo; free, keyless) ---
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_MS=8000
WEATHER_CACHE_TTL_MINUTES=45

# --- Gmail purchase-import integration (optional; unset = feature inert) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to `${PUBLIC_BASE_URL}/api/v1/commerce/gmail/oauth/callback` if unset.
GOOGLE_OAUTH_REDIRECT_URI=
# Random string, 32+ chars in production. Encrypts stored Gmail OAuth tokens.
COMMERCE_TOKEN_ENCRYPTION_KEY=
GMAIL_LOOKBACK_DAYS=90
GMAIL_MAX_MESSAGES_PER_SYNC_RUN=40
GMAIL_SYNC_BUDGET_MS=45000
GMAIL_SYNC_RATE_LIMIT_MAX=5
GMAIL_API_REQUEST_TIMEOUT_MS=10000

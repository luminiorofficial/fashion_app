PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=./data/uploads
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5

# Use console for local auto-filled OTPs or twilio for real SMS delivery.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure either a Messaging Service SID or a Twilio sender number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Retries per model on 429/500/502/503/504 and network/timeout failures,
# with exponential backoff starting at the base delay below.
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=500

# PostgreSQL. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/nera
DATABASE_POOL_MAX=10
# Keep SSL disabled for a standard local pgAdmin/PostgreSQL installation.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Cloudflare R2 (private image storage). Leave R2_BUCKET empty to fall back
# to local disk storage under UPLOAD_DIR — development/testing only, since
# local files are served back over plain, unsigned HTTP.
# Set IMAGE_STORAGE_PROVIDER=r2 in deployed environments. Production refuses
# to start unless all R2 values below are configured.
IMAGE_STORAGE_PROVIDER=local
# Create an R2 API token with Object Read & Write access, scoped to this
# bucket, from the Cloudflare dashboard: R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the derived https://<account>.r2.cloudflarestorage.com endpoint.
R2_ENDPOINT=
# How long a signed image URL handed to the app stays valid.
R2_SIGNED_URL_TTL_SECONDS=900

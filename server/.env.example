PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=./data/uploads
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5

# Use console for local auto-filled OTPs or twilio for real SMS delivery.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure either a Messaging Service SID or a Twilio sender number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Retries per model on 429/500/502/503/504 and network/timeout failures,
# with exponential backoff starting at the base delay below.
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=500

# PostgreSQL. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/nera
DATABASE_POOL_MAX=10
# Keep SSL disabled for a standard local pgAdmin/PostgreSQL installation.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=./data/uploads
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5

# Use console for local auto-filled OTPs or twilio for real SMS delivery.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure either a Messaging Service SID or a Twilio sender number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Legacy shared key/retry setting. Used as a fallback for whichever of
# GEMINI_TEXT_API_KEY / GEMINI_IMAGE_API_KEY below is left unset, so a
# single-key setup keeps working; set both split keys to actually separate
# billing/quota between text analysis and paid image generation.
GEMINI_API_KEY=
GEMINI_MAX_RETRIES=3
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RETRY_BASE_DELAY_MS=500

# Text/JSON analysis: wardrobe item analysis, style profile analysis, and
# outfit styling. Retries use exponential backoff from the base delay above.
GEMINI_TEXT_API_KEY=
GEMINI_TEXT_MAX_RETRIES=3

# Virtual try-on uses a separate, paid, image-capable model family from the
# text/JSON analysis model above. GEMINI_IMAGE_API_KEY (or GEMINI_API_KEY) is
# required; without it the endpoint returns TRYON_SERVICE_UNAVAILABLE and
# never substitutes the profile photo. Image output options are sent using
# generationConfig.responseFormat.image, and only IMAGE (not TEXT) output is
# requested. Retries are kept low by default so a failing try-on doesn't
# leave the user waiting through several slow paid attempts.
GEMINI_IMAGE_API_KEY=
# 0 by default: the primary/fallback model chain below already retries on a
# different model, so a same-model retry on top of that just doubles
# worst-case latency. Raise this only if you want same-model retries too.
GEMINI_IMAGE_MAX_RETRIES=0
# Primary model is the cheapest/fastest flash-lite variant; the standard
# flash model is the fallback if it's unavailable or fails.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-image
# Higher-quality (and pricier) model, never used automatically — only when
# GEMINI_IMAGE_HIGH_QUALITY_MODE=true below.
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
GEMINI_IMAGE_HIGH_QUALITY_MODE=false
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_ASPECT_RATIO=3:4
# Per-attempt Gemini image request timeout. Image generation can take longer
# than ordinary APIs, so this must remain at least 120000 milliseconds.
GEMINI_IMAGE_TIMEOUT_MS=120000
# Garment/profile images are downscaled to this longest side (pixels) before
# being sent to the paid image model, to cut input cost. The larger version
# stays in Cloudinary for display and is unaffected.
GEMINI_IMAGE_MAX_INPUT_PX=1024

# PostgreSQL. URL-encode special characters in the password.
# Required in production: the server refuses to start in production without
# it rather than silently falling back to the temporary in-memory adapter.
DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/nera
DATABASE_POOL_MAX=10
# Keep SSL disabled for a standard local pgAdmin/PostgreSQL installation.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Private image storage. Leave IMAGE_STORAGE_PROVIDER unset to auto-select:
# Cloudinary if fully configured, otherwise local disk (development/testing
# only, since local files are served back over plain, unsigned HTTP).
# Production refuses to start with "local" storage and requires Cloudinary
# to be fully configured; set IMAGE_STORAGE_PROVIDER explicitly in deployed
# environments.
IMAGE_STORAGE_PROVIDER=local

# Cloudinary (private image storage). Find these under Cloudinary Console >
# Dashboard > Product Environment Credentials. Images always upload with
# delivery type "authenticated" (never Cloudinary's public "upload" type),
# so nothing is servable without a signed URL minted by this server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Path prefix under which every image is stored in the Cloudinary account.
# New uploads are automatically routed into a purpose-specific sub-folder
# under this prefix, per-user, per-asset:
#   {CLOUDINARY_FOLDER}/profiles/{userId}/{uuid}  (profile_analysis)
#   {CLOUDINARY_FOLDER}/wardrobe/{userId}/{uuid}  (wardrobe_item)
#   {CLOUDINARY_FOLDER}/tryons/{userId}/{uuid}    (tryon_result)
CLOUDINARY_FOLDER=nera
# Optional but recommended: a token-based authentication key created in
# Cloudinary Console > Settings > Security > Token-based authentication.
# Without it, signed Cloudinary URLs are still private/authenticated but do
# not expire; with it, URLs expire after CLOUDINARY_SIGNED_URL_TTL_SECONDS.
CLOUDINARY_AUTH_TOKEN_KEY=
CLOUDINARY_SIGNED_URL_TTL_SECONDS=900

# Periodic housekeeping (see server/src/cleanup.js): purges expired OTP
# challenges, stale sessions, orphaned AI analysis results, unsaved virtual
# try-on results (and their Cloudinary objects) past their retention window,
# and long-deleted media rows nothing still references. Runs on this
# interval against a real (PostgreSQL) database only; also runnable
# on-demand via `npm run db:cleanup` for an external cron/scheduled task.
CLEANUP_INTERVAL_MINUTES=360
OTP_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
ANALYSIS_JOB_RETENTION_DAYS=14
MEDIA_ASSET_RETENTION_DAYS=14
TRYON_UNSAVED_RETENTION_HOURS=24
